ENVIRONMENT=development
LOG_LEVEL=INFO

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated, tried in order — verified against a real call on
# 2026-08-27; check openrouter.ai/models periodically, free-tier availability rotates
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free
# Must be vision-capable models — used only by the Vision/OCR agent
OPENROUTER_VISION_FALLBACK_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-26b-a4b-it:free

# Facebook Graph API (tools/fb_graph_api_tools.py) — optional. Leave both
# blank to keep using the CSV-import fallback (social_csv_tools.py).
# FB_PAGE_ID + a Page Access Token: Graph API Explorer -> select your app ->
# your Page -> request pages_show_list + pages_read_engagement -> Generate
# Access Token. Works for any Page you admin, no App Review needed.
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_API_VERSION=v21.0

# Web search tool (tools/web_search_tools.py) — free key at tavily.com
TAVILY_API_KEY=
