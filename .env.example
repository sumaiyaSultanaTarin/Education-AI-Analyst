ENVIRONMENT=development
LOG_LEVEL=INFO

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated, tried in order — check openrouter.ai/models for current free-tier availability
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free
# Must be vision-capable models — used only by the Vision/OCR agent
OPENROUTER_VISION_FALLBACK_MODELS=meta-llama/llama-3.2-11b-vision-instruct:free,qwen/qwen2.5-vl-32b-instruct:free
