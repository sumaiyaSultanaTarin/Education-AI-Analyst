.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
.ipynb_checkpoints/
tmp/
.claude/settings.local.json

# uploaded/generated data — never committed, folder tracked via .gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/chroma_db/*
!data/chroma_db/.gitkeep

# local SQLite dev DB — -shm/-wal are SQLite's WAL-mode sidecar files,
# created alongside data/checkpoints.db (langgraph-checkpoint-sqlite)
*.sqlite3
*.db
*.db-shm
*.db-wal